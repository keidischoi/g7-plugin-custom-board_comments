{
    "identifier": "g7-plugin-custom-board_comments",
    "vendor": "g7",
    "name": {
        "ko": "게시판 댓글 확장",
        "en": "Custom Board Comments"
    },
    "version": "0.1.2",
    "license": "MIT",
    "description": {
        "ko": "공식 게시판 댓글에 추천, 베스트 댓글, 정렬을 테마 수정 없이 추가합니다.",
        "en": "Adds likes, best comments, and sorting to official board comments without theme edits."
    },
    "g7_version": ">=7.0.0",
    "dependencies": {
        "modules": {
            "sirsoft-board": ">=1.0.0"
        },
        "plugins": {}
    },
    "github_url": "https://github.com/keidischoi/g7-plugin-custom-board_comments",
    "github_changelog_url": "https://github.com/keidischoi/g7-plugin-custom-board_comments/blob/main/CHANGELOG.md",
    "assets": {
        "js": {
            "entry": "resources/js/index.ts",
            "output": "dist/js/plugin.iife.js"
        },
        "css": {
            "entry": "resources/css/plugin.css",
            "output": "dist/css/plugin.css"
        },
        "handlers": true
    },
    "loading": {
        "strategy": "global",
        "priority": 80
    }
}
